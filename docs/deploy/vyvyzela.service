[Unit]
Description=Constellation Planning Service (KosmoHackathon 2026)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=vyvyzela
Group=vyvyzela
WorkingDirectory=/opt/vyvyzela
ExecStart=/opt/vyvyzela/.venv/bin/uvicorn service.app:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3
# Bind :80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
